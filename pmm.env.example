# Copy to ~/.config/mcp/pmm.env and fill in your own values (never commit the real file).
# The values below are fake examples.

# Required
PMM_URL=https://pmm.example.com
# Grafana service-account token: Administration -> Service accounts -> role Viewer -> Add token
PMM_TOKEN=glsa_EXAMPLEexampleEXAMPLEexample1234567890_abcdef12

# TLS verification is on by default. For a private CA prefer PMM_CA_BUNDLE=/path/to/ca.pem
# Set PMM_VERIFY=0 only for self-signed certificates you trust.
PMM_VERIFY=1
#PMM_CA_BUNDLE=/etc/ssl/certs/my-company-ca.pem
#PMM_TIMEOUT=60

# Only if your PMM uses non-default Grafana datasource UIDs (find them in Grafana: Connections -> Data sources)
#PMM_METRICS_UID=PA58DA793C7250F1B
#PMM_CLICKHOUSE_UID=PDEE91DDB90597936

# Read-only by default. Uncomment ONLY if you want the model to be able to create/expire silences and add
# annotations. This needs an Editor/Admin token, and every write still needs confirm=true.
#PMM_ALLOW_WRITE=1
